{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/polski-platform/browser",
  "trailingSlash": false,
  "redirects": [
    { "source": "/seo", "destination": "/", "permanent": true },
    { "source": "/seo/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/app.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    { "source": "/ngsw.json", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/ngsw-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/test", "headers": [{ "key": "X-Robots-Tag", "value": "index, follow" }] },
    { "source": "/auth", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/course/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/course-test/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/trainer", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/grammar", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/vocabulary", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/mistakes", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/learn/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/feedback", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites": [
    { "source": "/", "destination": "/seo/index.html" },
    { "source": "/ru", "destination": "/ru/index.html" },
    { "source": "/ru/padezhi", "destination": "/ru/padezhi/index.html" },
    { "source": "/ru/glagoly-dvizheniya", "destination": "/ru/glagoly-dvizheniya/index.html" },
    { "source": "/ru/ekzamen-b1-b2", "destination": "/ru/ekzamen-b1-b2/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/polish-cases", "destination": "/en/polish-cases/index.html" },
    { "source": "/nauka/polskie-znaki", "destination": "/nauka/polskie-znaki/index.html" },
    { "source": "/gramatyka/przypadki", "destination": "/gramatyka/przypadki/index.html" },
    { "source": "/slownictwo/podstawowe-zwroty", "destination": "/slownictwo/podstawowe-zwroty/index.html" },
    { "source": "/auth", "destination": "/app.html" },
    { "source": "/test", "destination": "/app.html" },
    { "source": "/course/:path*", "destination": "/app.html" },
    { "source": "/course-test/:path*", "destination": "/app.html" },
    { "source": "/trainer", "destination": "/app.html" },
    { "source": "/grammar", "destination": "/app.html" },
    { "source": "/vocabulary", "destination": "/app.html" },
    { "source": "/mistakes", "destination": "/app.html" },
    { "source": "/learn/:path*", "destination": "/app.html" },
    { "source": "/feedback", "destination": "/app.html" }
  ]
}

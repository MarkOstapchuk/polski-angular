{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/app.html",
  "navigationUrls": [
    "/**",
    "!/",
    "!/ru",
    "!/ru/**",
    "!/en",
    "!/en/**",
    "!/seo",
    "!/seo/**",
    "!/nauka/**",
    "!/gramatyka/**",
    "!/slownictwo/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/app.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/favicon.svg",
          "/icons/**"
        ]
      }
    },
    {
      "name": "course-data",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/content/**"
        ]
      }
    },
    {
      "name": "lesson-audio",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/telegram_audio/**"
        ]
      }
    },
    {
      "name": "part-2-audio",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/telegram_audio_2/**"
        ]
      }
    },
    {
      "name": "workbook-images",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/workbook/**"
        ]
      }
    }
  ]
}

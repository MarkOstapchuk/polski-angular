{
  "name": "polski-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "generate-env": "node scripts/generate-env.mjs",
    "prestart": "npm run generate-env",
    "start": "ng serve",
    "prebuild": "npm run generate-env",
    "build": "ng build --configuration production && node scripts/seo-build.mjs",
    "prebuild:dev": "npm run generate-env",
    "build:dev": "ng build --configuration development",
    "prepreview:pwa": "npm run generate-env",
    "preview:pwa": "ng serve --configuration production",
    "prewatch": "npm run generate-env",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "@supabase/supabase-js": "^2.100.1",
    "posthog-js": "^1.453.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "typescript": "^6.0.0"
  }
}
